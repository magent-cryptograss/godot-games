; Engine configuration file.
; SMASH 16 -- a 16-bit platform fighter

config_version=5

[application]

config/name="SMASH 16"
config/description="A 16-bit platform fighter. Build up percent, knock them off the screen."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sfx="*res://scripts/Sfx.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=224
window/size/window_width_override=1152
window/size/window_height_override=672
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
